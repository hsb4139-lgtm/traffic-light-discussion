# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 GitHub에 올라가지 않아요)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 비밀 값 — 절대 공유하지 마세요
SUPABASE_SERVICE_ROLE_KEY=
STUDENT_SESSION_SECRET=
# 선생님 가입 화면 보이기(처음 1번 가입 후 false 로 바꾸기)
NEXT_PUBLIC_ALLOW_SIGNUP=true
# 모둠원 누구나 모둠 신호등 입력 허용(기본: 모둠 대표만)
ALLOW_ANY_GROUP_MEMBER=false
